LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Providers: swap vendors without code changes
STT_PROVIDER=gemini
TTS_PROVIDER=gemini
LLM_PROVIDER=gemini

# Vendor keys (fill in .env, never commit)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (Day 2 / F1)
SUPABASE_URL=
# Transaction pooler string, e.g. postgresql://postgres.<ref>:<password>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=
