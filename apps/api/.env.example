LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Providers: swap vendors without code changes
LLM_PROVIDER=groq
STT_PROVIDER=groq
TTS_PROVIDER=groq
# Keep fixed: changing it means re-running scripts/seed_questions.py
EMBEDDING_PROVIDER=gemini

# Vendor keys (fill in .env, never commit)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high, or empty for non-reasoning models
GROQ_REASONING_EFFORT=low
# Fall back to bank questions if JD question generation is slower than this
JD_GENERATION_TIMEOUT_SECONDS=3.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (Day 2 / F1)
SUPABASE_URL=
# Public key; Storage calls use it with the caller JWT (RLS applies)
SUPABASE_PUBLISHABLE_KEY=
# Use the pooler (IPv4), not db.<ref>.supabase.co (IPv6-only). Transaction mode, port 6543:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
